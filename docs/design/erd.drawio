        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    VEHICLES ||--|| TELEMATICS_DEVICES : \&quot;1:1 has installed (ON DELETE CASCADE)\&quot;\n    VEHICLES ||--o{ TRIPS : \&quot;1:0..* assigned to (NO ACTION)\&quot;\n    DRIVERS ||--o{ TRIPS : \&quot;1:0..* operates (NO ACTION)\&quot;\n    TRIPS ||--o{ TELEMETRY_READINGS : \&quot;1:0..* records during (ON DELETE SET NULL)\&quot;\n    TELEMATICS_DEVICES ||--o{ TELEMETRY_READINGS : \&quot;1:0..* transmits (NO ACTION)\&quot;\n    TELEMETRY_READINGS ||--o{ SAFETY_AND_FAULT_ALERTS : \&quot;1:0..* triggers (ON DELETE CASCADE)\&quot;\n    VEHICLES ||--o{ SAFETY_AND_FAULT_ALERTS : \&quot;1:0..* accumulates (NO ACTION)\&quot;\n    VEHICLES ||--o{ MAINTENANCE_ORDERS : \&quot;1:0..* undergoes (NO ACTION)\&quot;\n    SAFETY_AND_FAULT_ALERTS ||--o| MAINTENANCE_ORDERS : \&quot;1:0..1 generates (ON DELETE SET NULL)\&quot;\n\n    VEHICLES {\n        VARCHAR2(15) vehicle_id PK\n        VARCHAR2(40) brand NN\n        VARCHAR2(15) plate_number UQ_NN\n        NUMBER(10_2) current_odometer CK_NN\n        VARCHAR2(20) operational_status CK_NN\n    }\n    TELEMATICS_DEVICES {\n        VARCHAR2(15) device_id PK\n        VARCHAR2(15) vehicle_id FK_UQ_NN\n        VARCHAR2(20) imei_serial UQ_NN\n        VARCHAR2(15) firmware_version NN\n        VARCHAR2(15) device_status CK_NN\n    }\n    DRIVERS {\n        VARCHAR2(15) driver_id PK\n        VARCHAR2(15) driver_code UQ_NN\n        VARCHAR2(5) license_category CK_NN\n        NUMBER(5_2) safety_score CK_NN\n        VARCHAR2(15) driver_status CK_NN\n    }\n    TRIPS {\n        VARCHAR2(15) trip_id PK\n        VARCHAR2(15) vehicle_id FK_NN\n        VARCHAR2(15) driver_id FK_NN\n        TIMESTAMP start_time NN\n        TIMESTAMP end_time CK\n        VARCHAR2(40) origin_zone NN\n        VARCHAR2(40) destination_zone NN\n        VARCHAR2(15) trip_status CK_NN\n    }\n    TELEMETRY_READINGS {\n        NUMBER(10) reading_id PK_IDENTITY\n        VARCHAR2(15) device_id FK_NN\n        VARCHAR2(15) trip_id FK_NULL\n        TIMESTAMP recorded_at UQ_COMP_NN\n        NUMBER(10_2) odometer_km CK_NN\n        NUMBER(5_2) engine_temp_c CK_NN\n        NUMBER(5_0) engine_rpm CK_NN\n        NUMBER(5_2) oil_pressure_psi CK_NN\n        NUMBER(5_2) coolant_temp_c CK_NN\n        NUMBER(5_2) fuel_level_pct CK_NN\n        NUMBER(5_2) fuel_consumption_lph CK_NN\n    }\n    SAFETY_AND_FAULT_ALERTS {\n        NUMBER(10) alert_id PK_IDENTITY\n        NUMBER(10) reading_id FK_NN\n        VARCHAR2(15) vehicle_id FK_NN\n        VARCHAR2(25) alert_category CK_NN\n        VARCHAR2(15) severity_level CK_NN\n        CHAR(1) is_resolved CK_NN\n        TIMESTAMP created_at NN\n    }\n    MAINTENANCE_ORDERS {\n        NUMBER(10) order_id PK_IDENTITY\n        VARCHAR2(15) vehicle_id FK_NN\n        NUMBER(10) alert_id FK_NULL\n        VARCHAR2(30) component_type NN\n        DATE scheduled_date NN\n        DATE completed_date CK\n        NUMBER(10_2) repair_cost CK_NN\n        VARCHAR2(15) order_status CK_NN\n    }\n    SYSTEM_AUDIT_LOG {\n        NUMBER(10) audit_id PK_IDENTITY\n        VARCHAR2(30) table_name NN\n        VARCHAR2(15) operation_type CK_NN\n        VARCHAR2(30) db_user NN\n        TIMESTAMP action_timestamp NN\n        VARCHAR2(15) status_flag CK_NN\n        VARCHAR2(255) details NN\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="2">
